#!/bin/sh
# 大文件护栏（2026-10-09）：阻止提交 >50MB 的文件。
#
# 背景：另一个会话用 `git add -f` 提交了一个 220MB 的 parquet（`t_io/**` 本已忽略，
# 但 `-f` 会**绕过 .gitignore**）。GitHub 硬限 100MB ⇒ **整条推送被服务器拒绝**，
# 连带 11 个提交全堵住，只能 filter-branch 重写历史才清掉。
#
# 安装（本文件是版本化副本；`.git/hooks/` 不入库）：
#   cp scripts/git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# 绕过（确需入库时）：git commit --no-verify
#
LIMIT=52428800   # 50MB
fail=0
for f in $(git diff --cached --name-only --diff-filter=AM); do
  [ -f "$f" ] || continue
  sz=$(wc -c < "$f" 2>/dev/null || echo 0)
  if [ "$sz" -gt "$LIMIT" ]; then
    echo "✖ 拒绝提交大文件（$((sz / 1048576))MB > 50MB）：$f" >&2
    fail=1
  fi
done
if [ "$fail" != 0 ]; then
  echo "  提示：确需入库用 git commit --no-verify；否则先加入 .gitignore。" >&2
  exit 1
fi
exit 0
